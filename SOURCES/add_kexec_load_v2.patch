+bool xen_is_locked_down(void)
+{
+	static int locked_down = -1;
+	FILE *f;
+	char buf[6];
+
+	if (locked_down >= 0)
+		goto out;
+
+	f = fopen("/sys/kernel/security/lockdown", "r");
+	if (!f) {
+		locked_down = 0;
+		goto out;
+	}
+	if (fread(buf, 1, sizeof(buf), f) != sizeof(buf)) {
+		fclose(f);
+		locked_down = 0;
+		goto out;
+	}
+	fclose(f);
+	locked_down = strcmp(buf, "[none]") ? 1 : 0;
+
+out:
+	return locked_down == 1;
+}
+
 static uint8_t xen_get_kexec_type(unsigned long kexec_flags)
 {
-	if (kexec_flags & KEXEC_ON_CRASH)
-		return KEXEC_TYPE_CRASH;
+	if (kexec_flags & KEXEC_ON_CRASH) {
+		if (xen_is_locked_down())
+			return KEXEC_TYPE_CRASH_EFI;
+		else
+			return KEXEC_TYPE_CRASH;
+	}
 
 	if (kexec_flags & KEXEC_LIVE_UPDATE)
 		return KEXEC_TYPE_LIVE_UPDATE;
 
+	if (xen_is_locked_down())
+		return KEXEC_TYPE_CRASH_EFI;
+
 	return KEXEC_TYPE_DEFAULT;
 }
 
@@ -113,7 +147,8 @@ int xen_kexec_load(struct kexec_info *info)
 	xc_hypercall_buffer_array_t *array = NULL;
 	uint8_t type;
 	uint8_t arch;
-	xen_kexec_segment_t *xen_segs, *seg;
+	xen_kexec_segment_t *xen_segs, *seg, swap_seg;
+	xen_kexec_segment_t *kernel_seg = NULL;
 	int s;
 	int ret = -1;
 
@@ -175,6 +210,10 @@ int xen_kexec_load(struct kexec_info *info)
 		seg->buf_size = segments[s].bufsz;
 		seg->dest_maddr = (uint64_t)segments[s].mem;
 		seg->dest_size = segments[s].memsz;
+
+		if (segments[s].is_kernel)
+			kernel_seg = seg;
+
 		seg++;
 
 		low_watermark = (uint64_t)segments[s].mem + segments[s].memsz;
@@ -188,6 +227,12 @@ int xen_kexec_load(struct kexec_info *info)
 		seg++;
 	}
 
+	if (kernel_seg) {
+		swap_seg = *kernel_seg;
+		*kernel_seg = *xen_segs;
+		*xen_segs = swap_seg;
+	}
+
 	type = xen_get_kexec_type(info->kexec_flags);
 
 	arch = (info->kexec_flags & KEXEC_ARCH_MASK) >> 16;
@@ -196,8 +241,8 @@ int xen_kexec_load(struct kexec_info *info)
 		arch = EM_386;
 #endif
 
-	ret = xc_kexec_load(xch, type, arch, (uint64_t)info->entry,
-			    nr_segments + nr_low_segments, xen_segs);
+        ret = xc_kexec_load(xch, type, arch, (uint64_t)info->entry,
+                              nr_segments + nr_low_segments, xen_segs);
 
 out:
 	xc_hypercall_buffer_array_destroy(xch, array);
