+static int do_xen_bzImage64_load(struct kexec_info *info,
+			const char *kernel, off_t kernel_len,
+			const char *command_line, off_t command_line_len,
+			const char *initrd, off_t initrd_len)
+{
+	struct x86_linux_header setup_header;
+	struct x86_linux_param_header *real_mode;
+	int setup_sects;
+	size_t size;
+	int kern16_size;
+	unsigned long setup_base, setup_size, setup_header_size;
+	char *modified_cmdline;
+	unsigned long align, addr;
+	unsigned kern16_size_needed;
+
+	/*
+	 * Find out about the file I am about to load.
+	 */
+	if (kernel_len < (2 * 512))
+		return -1;
+
+	memcpy(&setup_header, kernel, sizeof(setup_header));
+	setup_sects = setup_header.setup_sects;
+	if (setup_sects == 0)
+		setup_sects = 4;
+	kern16_size = (setup_sects + 1) * 512;
+	if (kernel_len < kern16_size) {
+		fprintf(stderr, "BzImage truncated?\n");
+		return -1;
+	}
+
+	if ((uintmax_t)command_line_len > (uintmax_t)setup_header.cmdline_size) {
+		dbgprintf("Kernel command line too long for kernel!\n");
+		return -1;
+	}
+
+	/* Need to append some command line parameters internally in case of
+	 * taking crash dumps.
+	 */
+	if (info->kexec_flags & (KEXEC_ON_CRASH | KEXEC_PRESERVE_CONTEXT)) {
+		modified_cmdline = xmalloc(COMMAND_LINE_SIZE);
+		memset((void *)modified_cmdline, 0, COMMAND_LINE_SIZE);
+		if (command_line) {
+			strncpy(modified_cmdline, command_line,
+					COMMAND_LINE_SIZE);
+			modified_cmdline[COMMAND_LINE_SIZE - 1] = '\0';
+		}
+
+		/* If panic kernel is being loaded, additional segments need
+		 * to be created. load_crashdump_segments will take care of
+		 * loading the segments as high in memory as possible, hence
+		 * in turn as away as possible from kernel to avoid being
+		 * stomped by the kernel.
+		 */
+		if (load_crashdump_segments(info, modified_cmdline, -1, 0) < 0)
+			return -1;
+
+		/* Use new command line buffer */
+		command_line = modified_cmdline;
+		command_line_len = strlen(command_line) + 1;
+	}
+
+	/* Do not load purgatory. It will be loaded by Xen for security reasons. */
+
+
+	/* The argument/parameter segment */
+	kern16_size_needed = kern16_size;
+	if (kern16_size_needed < 4096)
+		kern16_size_needed = 4096;
+	setup_size = kern16_size_needed + command_line_len + PURGATORY_CMDLINE_SIZE;
+	real_mode = xmalloc(setup_size);
+	memset(real_mode, 0, setup_size);
+
+	/* only copy setup_header */
+	setup_header_size = kernel[0x201] + 0x202 - 0x1f1;
+	if (setup_header_size > 0x7f)
+		setup_header_size = 0x7f;
+	memcpy((unsigned char *)real_mode + 0x1f1, kernel + 0x1f1,
+		 setup_header_size);
+
+	/* No real mode code will be executing. setup segment can be loaded
+	 * anywhere as we will be just reading command line.
+	 */
+	setup_base = add_buffer(info, real_mode, setup_size, setup_size,
+				16, 0x3000, -1, -1);
+
+	dbgprintf("Loaded real_mode_data and command line at 0x%lx\n",
+			setup_base);
+
+
+	/* The main kernel segment */
+	{
+		/* need to use run-time size for buffer searching */
+		size = _ALIGN(real_mode->init_size, 4096);
+		align = real_mode->kernel_alignment;
+
+		/* Traditional kexec chops off the kernel header and only loads
+		 * kernel+kern16_size but for the kernel to cryptographically verify
+		 * integrity we need to load the whole kernel image.
+		 *
+		 * Loading the whole kernel complicates things because kernel+kern16 still
+		 * needs to be aligned with kernel_alignment however this is now in the
+		 * middle of the buffer rather than the start.
+		 *
+		 * Here we find a memory hole bigger than we need and then later we will
+		 * adjust the start address to achieve the correct alignment.
+		 *
+		 *    .- addr
+		 *    v
+		 *    +--------------------------------------+--------------------...
+		 *    | kern16 | kernel+kern16_size          |
+		 *    +--------------------------------------+--------------------...
+		 * 0x100000                               0x200000
+		 */
+		size += real_mode->kernel_alignment;
+		addr = add_buffer(info, kernel, kernel_len, size, align, 0x100000, -1, -1);
+		if (addr == ULONG_MAX)
+			die("can not load bzImage64");
+
+		/*
+		 *                                  .-addr   .-kernel_alignment
+		 *                                  v        v
+		 *    +--------------------------------------+--------------------...
+		 *    | waste                       | kern16 | kernel+kern16_size
+		 *    +--------------------------------------+--------------------...
+		 * 0x100000                               0x200000
+		 */
+		const unsigned long waste = real_mode->kernel_alignment - kern16_size;
+		addr += waste;
+		info->segment[info->nr_segments-1].mem   = (void*)addr;
+		info->segment[info->nr_segments-1].memsz -= waste;
+		info->segment[info->nr_segments-1].is_kernel = true;
+	}
+
+	info->entry = setup_base; // Kernel parameters
+
+
+	/* Tell the kernel what is going on */
+	setup_linux_bootloader_parameters_high(info, real_mode, setup_base,
+			kern16_size_needed, command_line, command_line_len,
+			initrd, initrd_len, 1); /* put initrd high too */
+
+
+	/* Fill in the information BIOS calls would normally provide. */
+	setup_linux_system_parameters(info, real_mode);
+
+	return 0;
+}
+
 static int do_bzImage64_load(struct kexec_info *info,
 			const char *kernel, off_t kernel_len,
 			const char *command_line, off_t command_line_len,
@@ -383,7 +533,11 @@ int bzImage64_load(int argc, char **argv, const char *buf, off_t len,
 	if (ramdisk)
 		ramdisk_buf = slurp_file(ramdisk, &ramdisk_length);
 
-	if (entry_16bit || entry_32bit)
+	if (xen_present() && xen_is_locked_down())
+		result = do_xen_bzImage64_load(info, buf, len, command_line,
+					command_line_len, ramdisk_buf,
+					ramdisk_length);
+	else if (entry_16bit || entry_32bit)
 		result = do_bzImage_load(info, buf, len, command_line,
 					command_line_len, ramdisk_buf,
 					ramdisk_length, 0, 0, entry_16bit);
